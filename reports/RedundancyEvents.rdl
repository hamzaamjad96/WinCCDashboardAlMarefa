      <Query>
        <DataSourceName>WinCCReportingDS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>dbo.usp_ReportCategoryEvents</CommandText>
        <QueryParameters>
          <QueryParameter Name="@Category">
            <Value>Redundancy</Value>
          </QueryParameter>
          <QueryParameter Name="@PageNumber">
            <Value>1</Value>
          </QueryParameter>
          <QueryParameter Name="@PageSize">
            <Value>500</Value>
          </QueryParameter>
          <QueryParameter Name="@Search">
