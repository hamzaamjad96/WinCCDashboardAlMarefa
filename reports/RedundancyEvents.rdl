  <ReportParameters>
    <ReportParameter Name="Search">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <DefaultValue>
        <Values>
          <Value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
        </Values>
      </DefaultValue>
      <Prompt>Search</Prompt>
    </ReportParameter>
    <ReportParameter Name="Priority">
      <DataType>Integer</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
        </Values>
      </DefaultValue>
      <Prompt>Priority</Prompt>
    </ReportParameter>
    <ReportParameter Name="SourceServer">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <DefaultValue>
        <Values>
          <Value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
        </Values>
      </DefaultValue>
      <Prompt>Source Server</Prompt>
    </ReportParameter>
    <ReportParameter Name="StartDate">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
        </Values>
      </DefaultValue>
      <Prompt>From</Prompt>
    </ReportParameter>
    <ReportParameter Name="EndDate">
      <DataType>DateTime</DataType>
      <Nullable>true</Nullable>
      <DefaultValue>
        <Values>
          <Value xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:nil="true"/>
        </Values>
      </DefaultValue>
      <Prompt>To</Prompt>
    </ReportParameter>
  </ReportParameters>
  <Code>' Header helpers (culture-independent; parameters may be ISO strings or dates).
Private Formats() As String = New String() { _
    "yyyy-MM-ddTHH:mm:ss", "yyyy-MM-ddTHH:mm:ss.fff", "yyyy-MM-ddTHH:mm", _
    "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm", "yyyy-MM-dd"}

Private Function TryGetDate(ByVal value As Object, ByRef result As DateTime) As Boolean
    If value Is Nothing OrElse IsDBNull(value) Then Return False
    If TypeOf value Is DateTime Then
        result = CType(value, DateTime)
        Return True
    End If
    Dim text As String = CStr(value).Trim()
    If text.Length = 0 Then Return False
    Return DateTime.TryParseExact(text, Formats, _
        System.Globalization.CultureInfo.InvariantCulture, _
        System.Globalization.DateTimeStyles.None, result)
End Function

Private Function Iso(ByVal d As DateTime, ByVal withTime As Boolean) As String
    If withTime Then
        Return d.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
    End If
    Return d.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)
End Function

' "2026-10-01 to 2026-10-05 (UTC)". The end bound is exclusive in the stored
' procedures (RaiseTime &lt; @EndDate), so a midnight end shows the previous day.
Public Function FormatRange(ByVal startValue As Object, ByVal endValue As Object) As String
    Dim s As DateTime
    Dim e As DateTime
    Dim startText As String = "last 30 days"
    Dim endText As String = "now"
    If TryGetDate(startValue, s) Then startText = Iso(s, s.TimeOfDay &lt;&gt; TimeSpan.Zero)
    If TryGetDate(endValue, e) Then
        If e.TimeOfDay = TimeSpan.Zero Then
            endText = Iso(e.AddDays(-1), False)
        Else
            endText = Iso(e, True)
        End If
    End If
    If startText = "last 30 days" AndAlso endText = "now" Then Return "Last 30 days (UTC)"
    Return startText &amp; "  to  " &amp; endText &amp; "  (UTC)"
End Function

Public Function OrAll(ByVal value As Object, ByVal allText As String) As String
    If value Is Nothing OrElse IsDBNull(value) Then Return allText
    Dim text As String = CStr(value).Trim()
    If text.Length = 0 Then Return allText
    Return text
End Function</Code>
  <Language>en-US</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
</Report>
