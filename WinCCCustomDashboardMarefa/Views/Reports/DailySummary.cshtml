@model WinCCCustomDashboardMarefa.Models.PagedResult<WinCCCustomDashboardMarefa.Models.DailyAlarmSummary>

@{
    ViewData["Title"] = "Daily Alarm Summary";

    var filter =
        ViewBag.Filter as WinCCCustomDashboardMarefa.Models.AlarmReportFilter
        ?? new WinCCCustomDashboardMarefa.Models.AlarmReportFilter();

    var firstRecord =
        Model.TotalCount == 0
            ? 0
            : ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var lastRecord =
        Math.Min(
            Model.PageNumber * Model.PageSize,
            (int)Model.TotalCount);
}

<div class="page-header">

    <div>
        <h1>Daily Alarm Summary</h1>

        <p class="page-subtitle">
            Daily alarm activity and priority analysis
        </p>
    </div>

    <a asp-controller="Reports"
       asp-action="Index"
       class="btn btn-secondary">
        All Reports
    </a>

</div>


@await Html.PartialAsync("_ReportsNav")


<!-- Filters -->

<div class="card">

    <div class="card-header">

        <div>
            <h2>Filters</h2>

            <span class="card-description">
                Filter the daily alarm summary
            </span>
        </div>

    </div>


    <form asp-controller="Reports"
          asp-action="DailySummary"
          method="get"
          class="report-filters">

        <input type="hidden"
               name="page"
               value="1" />

        <input type="hidden"
               name="pageSize"
               value="@Model.PageSize" />


        <div class="filter-group">

            <label for="priority">
                Priority
            </label>

            <select id="priority"
                    name="priority">

                <option value="">
                    All Priorities
                </option>

                <option value="0"
                        selected="@(filter.Priority == 0 ? "selected" : null)">
                    0
                </option>

                <option value="1"
                        selected="@(filter.Priority == 1 ? "selected" : null)">
                    1
                </option>

                <option value="4"
                        selected="@(filter.Priority == 4 ? "selected" : null)">
                    4
                </option>

                <option value="12"
                        selected="@(filter.Priority == 12 ? "selected" : null)">
                    12
                </option>

                <option value="16"
                        selected="@(filter.Priority == 16 ? "selected" : null)">
                    16
                </option>

            </select>

        </div>


        <div class="filter-group">

            <label for="sourceServer">
                Source Server
            </label>

            <select id="sourceServer"
                    name="sourceServer">

                <option value="">
                    All Servers
                </option>

                <option value="SRV-01"
                        selected="@(filter.SourceServer == "SRV-01" ? "selected" : null)">
                    SRV-01
                </option>

                <option value="SRV-02"
                        selected="@(filter.SourceServer == "SRV-02" ? "selected" : null)">
                    SRV-02
                </option>

            </select>

        </div>


        <div class="filter-group">

            <label for="startDate">
                From
            </label>

            <input type="datetime-local"
                   id="startDate"
                   name="startDate"
                   value="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))" />

        </div>


        <div class="filter-group">

            <label for="endDate">
                To
            </label>

            <input type="datetime-local"
                   id="endDate"
                   name="endDate"
                   value="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))" />

        </div>


        <div class="filter-actions">

            <button type="submit"
                    class="btn btn-primary">
                Apply Filters
            </button>

            <a asp-controller="Reports"
               asp-action="DailySummary"
               class="btn btn-secondary">
                Clear
            </a>

        </div>

    </form>

</div>


<!-- Actions -->

<div class="report-actions-bar">

    <div>

        @if (Model.TotalCount > 0)
        {
            <span class="results-info">

                Showing
                <strong>@firstRecord</strong>
                -
                <strong>@lastRecord</strong>
                of
                <strong>@Model.TotalCount</strong>
                days

            </span>
        }
        else
        {
            <span class="results-info">
                No data found
            </span>
        }

    </div>


    <a asp-controller="Reports"
       asp-action="ExportDailySummary"
       asp-route-priority="@filter.Priority"
       asp-route-sourceServer="@filter.SourceServer"
       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
       class="btn btn-danger">

        Generate PDF

    </a>

</div>


<!-- Summary Table -->

<div class="card">

    <div class="card-header">

        <div>
            <h2>Daily Summary</h2>

            <span class="card-description">
                Alarm counts grouped by day
            </span>
        </div>

    </div>


    <div class="table-wrapper">

        <table class="data-table">

            <thead>

                <tr>
                    <th>Date</th>
                    <th>Total Alarms</th>
                    <th>High Priority</th>
                    <th>Priority 1</th>
                    <th>Priority 4</th>
                    <th>Priority 12</th>
                    <th>SRV-01</th>
                    <th>SRV-02</th>
                </tr>

            </thead>


            <tbody>

                @if (Model.Items.Count == 0)
                {
                    <tr>

                        <td colspan="8"
                            class="empty-state">

                            No alarm data found for the selected filters.

                        </td>

                    </tr>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @item.AlarmDate.ToString("yyyy-MM-dd")
                                </strong>
                            </td>

                            <td>
                                <strong>
                                    @item.TotalAlarms
                                </strong>
                            </td>

                            <td>
                                <span class="priority-badge">
                                    @item.HighPriorityAlarms
                                </span>
                            </td>

                            <td>
                                @item.Priority1Alarms
                            </td>

                            <td>
                                @item.Priority4Alarms
                            </td>

                            <td>
                                @item.Priority12Alarms
                            </td>

                            <td>
                                <span class="server-badge">
                                    @item.Srv01Alarms
                                </span>
                            </td>

                            <td>
                                <span class="server-badge">
                                    @item.Srv02Alarms
                                </span>
                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>


    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            <div class="pagination-info">

                Page
                <strong>@Model.PageNumber</strong>
                of
                <strong>@Model.TotalPages</strong>

            </div>


            <div class="pagination-buttons">

                @if (Model.PageNumber > 1)
                {
                    <a asp-controller="Reports"
                       asp-action="DailySummary"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-priority="@filter.Priority"
                       asp-route-sourceServer="@filter.SourceServer"
                       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="pagination-btn">

                        Previous

                    </a>
                }


                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span class="pagination-btn active">
                            @i
                        </span>
                    }
                    else if (
                        i == 1 ||
                        i == Model.TotalPages ||
                        Math.Abs(i - Model.PageNumber) <= 2)
                    {
                        <a asp-controller="Reports"
                           asp-action="DailySummary"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-priority="@filter.Priority"
                           asp-route-sourceServer="@filter.SourceServer"
                           asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                           asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                           class="pagination-btn">

                            @i

                        </a>
                    }
                }


                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-controller="Reports"
                       asp-action="DailySummary"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-priority="@filter.Priority"
                       asp-route-sourceServer="@filter.SourceServer"
                       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="pagination-btn">

                        Next

                    </a>
                }

            </div>

        </div>
    }

</div>