<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - WinCC Reporting
    </title>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

<div class="app">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <div>

                <div class="logo-title">
                    WinCC Reporting
                </div>

                <div class="logo-subtitle">
                    Unified Dashboard
                </div>

            </div>

        </div>


        <nav class="menu">

            <div class="menu-title">
                Main
            </div>


            <a asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">▣</span>

                <span>Dashboard</span>

            </a>


            <a asp-controller="Alarm"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">⚠</span>

                <span>Alarms</span>

            </a>


            <a asp-controller="Reports"
               asp-action="Index"
               class="menu-item">

                <span class="menu-icon">▤</span>

                <span>Reports</span>

            </a>

        </nav>


        <div style="margin-top:auto; padding:12px;">

            <a href="#"
               class="menu-item">

                <span class="menu-icon">⚙</span>

                <span>Settings</span>

            </a>

        </div>

    </aside>


    <!-- MAIN -->

    <main class="main">

        <header class="topbar">

            <div class="page-title">
                @ViewData["Title"]
            </div>


            <div class="topbar-right">

                <div class="system-status">

                    <span class="status-dot"></span>

                    <span>
                        System Online
                    </span>

                </div>

            </div>

        </header>


        <section class="content">

            @RenderBody()

        </section>

    </main>

</div>


<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync(
    "Scripts",
    required: false)

</body>

</html>