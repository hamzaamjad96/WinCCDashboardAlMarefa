@model WinCCDashboard.Domain.Common.PagedResult<
WinCCDashboard.Domain.Entities.AlarmEvent >

@{
    ViewData["Title"] = "Alarms";

    var firstRecord = Model.TotalCount == 0
        ? 0
        : ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var lastRecord = Math.Min(
        Model.PageNumber * Model.PageSize,
        (int)Model.TotalCount);

    var startPage = Math.Max(1, Model.PageNumber - 2);
    var endPage = Math.Min(
        Model.TotalPages,
        Model.PageNumber + 2);
}

<div class="page-header">
    <div>
        <h1>Alarms</h1>
        <p>WinCC Unified alarm history</p>
    </div>
</div>

<div class="panel">

    <!-- FILTERS -->

    <div class="alarm-filters">

        <form asp-controller="Alarm"
              asp-action="Index"
              method="get"
              class="filter-form">

            <div class="filter-group">
                <label>Search</label>

                <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       placeholder="Search alarm..." />
            </div>

            <div class="filter-group">
                <label>Priority</label>

                <select name="priority">
                    <option value="">All</option>

                    <option value="1" selected="@(Context.Request.Query["priority"] == "1" ? "selected" : null)">1</option>
                    <option value="2" selected="@(Context.Request.Query["priority"] == "2" ? "selected" : null)">2</option>
                    <option value="3" selected="@(Context.Request.Query["priority"] == "3" ? "selected" : null)">3</option>
                    <option value="4" selected="@(Context.Request.Query["priority"] == "4" ? "selected" : null)">4</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Source Server</label>

                <input type="text"
                       name="sourceServer"
                       value="@Context.Request.Query["sourceServer"]"
                       placeholder="SRV-01" />
            </div>

            <input type="hidden"
                   name="pageSize"
                   value="@Model.PageSize" />

            <button type="submit"
                    class="filter-button">
                Search
            </button>

            <a asp-controller="Alarm"
               asp-action="Index"
               class="clear-button">
                Clear
            </a>

        </form>

    </div>


    <!-- TABLE HEADER -->

    <div class="panel-header">

        <div class="panel-title">
            Alarm History
        </div>

        <div>
            Showing @firstRecord - @lastRecord
            of @Model.TotalCount alarms
        </div>

    </div>


    <!-- TABLE -->

    <div class="panel-body">

        <div class="table-wrapper">

            <table class="table">

                <thead>
                    <tr>
                        <th>Alarm</th>
                        <th>Priority</th>
                        <th>Raise Time</th>
                        <th>Source Server</th>
                        <th>Synced At</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                No alarms found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var alarm in Model.Items)
                        {
                            <tr>

                                <td>
                                    @alarm.AlarmName
                                </td>

                                <td>
                                    @(alarm.Priority?.ToString() ?? "-")
                                </td>

                                <td class="alarm-time"
                                    data-utc="@alarm.RaiseTime.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")">
                                </td>

                                <td>
                                    @alarm.SourceServer
                                </td>

                                <td class="alarm-time"
                                    data-utc="@alarm.SyncedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")">
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- PAGINATION -->
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">

            @if (Model.PageNumber > 1)
            {
                <a asp-controller="Alarm"
                   asp-action="Index"
                   asp-route-page="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-search="@Context.Request.Query["search"]"
                   asp-route-priority="@Context.Request.Query["priority"]"
                   asp-route-sourceServer="@Context.Request.Query["sourceServer"]"
                   class="pagination-button">
                    Previous
                </a>
            }

            @for (var i = startPage; i <= endPage; i++)
            {
                if (i == Model.PageNumber)
                {
                    <span class="pagination-button active">
                        @i
                    </span>
                }
                else
                {
                    <a asp-controller="Alarm"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@Context.Request.Query["search"]"
                       asp-route-priority="@Context.Request.Query["priority"]"
                       asp-route-sourceServer="@Context.Request.Query["sourceServer"]"
                       class="pagination-button">
                        @i
                    </a>
                }
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-controller="Alarm"
                   asp-action="Index"
                   asp-route-page="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-search="@Context.Request.Query["search"]"
                   asp-route-priority="@Context.Request.Query["priority"]"
                   asp-route-sourceServer="@Context.Request.Query["sourceServer"]"
                   class="pagination-button">
                    Next
                </a>
            }

        </div>
    }

</div>
