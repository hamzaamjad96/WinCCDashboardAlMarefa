@model List<WinCCDashboard.Domain.Entities.ReportDefinition>

@{
    ViewData["Title"] = "Reports";
    var grouped = Model
        .GroupBy(r => r.Category)
        .OrderBy(g => g.Key);
}

<div class="page-header">
    <div>
        <h1>Reports</h1>
        <p class="page-subtitle">
            WinCC Unified reports — powered by SQL Server Reporting Services
        </p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body" style="text-align:center; padding:40px;">
            <p>No reports are configured.</p>
            <p style="color:#6b7280; font-size:13px;">
                Ask your administrator to add report definitions.
            </p>
        </div>
    </div>
}
else
{
    foreach (var category in grouped)
    {
        <div class="card">
            <div class="card-header">
                <div>
                    <h2>@category.Key</h2>
                    <span class="card-description">
                        @category.Count() report@(category.Count() == 1 ? "" : "s")
                    </span>
                </div>
            </div>

            <div class="reports-grid">
                @foreach (var report in category)
                {
                    <a asp-action="Show"
                       asp-route-key="@report.ReportKey"
                       class="report-card">
                        <div class="report-content">
                            <h3>@report.Title</h3>
                            <p>@report.Description</p>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
}