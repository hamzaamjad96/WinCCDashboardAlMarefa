@model WinCCDashboard.Domain.Common.PagedResult<WinCCDashboard.Domain.Entities.AlarmEvent>
@{
    ViewData["Title"] = "Reports";

    var filter = ViewBag.Filter as WinCCDashboard.Domain.Entities.AlarmReportFilter
                 ?? new WinCCDashboard.Domain.Entities.AlarmReportFilter();

    var firstRecord = Model.TotalCount == 0
        ? 0 : ((Model.PageNumber - 1) * Model.PageSize) + 1;

    var lastRecord = Math.Min(
        Model.PageNumber * Model.PageSize, (int)Model.TotalCount);
}

<div class="page-header">
    <div>
        <h1>Reports</h1>
        <p class="page-subtitle">Generate and analyze WinCC Unified reports</p>
    </div>
</div>

@await Html.PartialAsync("_ReportsNav")

<!-- Filters -->
<div class="card">
    <div class="card-header">
        <div>
            <h2>Alarm History Filters</h2>
            <span class="card-description">Filter alarm history before viewing or exporting</span>
        </div>
    </div>

    <form asp-controller="Reports" asp-action="Index" method="get" class="report-filters">

        <input type="hidden" name="page" value="1" />
        <input type="hidden" name="pageSize" value="@Model.PageSize" />

        <div class="filter-group search-group">
            <label for="search">Search Alarm</label>
            <input type="text" id="search" name="search" value="@filter.Search"
                   placeholder="Search alarm name..." />
        </div>

        <div class="filter-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
                <option value="">All Priorities</option>
                <option value="0" selected="@(filter.Priority == 0 ? "selected" : null)">0</option>
                <option value="1" selected="@(filter.Priority == 1 ? "selected" : null)">1</option>
                <option value="4" selected="@(filter.Priority == 4 ? "selected" : null)">4</option>
                <option value="12" selected="@(filter.Priority == 12 ? "selected" : null)">12</option>
                <option value="16" selected="@(filter.Priority == 16 ? "selected" : null)">16</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="sourceServer">Source Server</label>
            <select id="sourceServer" name="sourceServer">
                <option value="">All Servers</option>
                <option value="SRV-01" selected="@(filter.SourceServer == "SRV-01" ? "selected" : null)">SRV-01</option>
                <option value="SRV-02" selected="@(filter.SourceServer == "SRV-02" ? "selected" : null)">SRV-02</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="startDate">From</label>
            <input type="datetime-local" id="startDate" name="startDate"
                   value="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="filter-group">
            <label for="endDate">To</label>
            <input type="datetime-local" id="endDate" name="endDate"
                   value="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-secondary">Clear</a>
        </div>
    </form>
</div>

<div class="report-actions-bar">
    <div>
        @if (Model.TotalCount > 0)
        {
            <span class="results-info">
                Showing <strong>@firstRecord</strong> - <strong>@lastRecord</strong>
                of <strong>@Model.TotalCount</strong> records
            </span>
        }
        else
        {
            <span class="results-info">No records found</span>
        }
    </div>

    <a asp-controller="Reports" asp-action="ExportAlarmHistory"
       asp-route-search="@filter.Search"
       asp-route-priority="@filter.Priority"
       asp-route-sourceServer="@filter.SourceServer"
       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
       class="btn btn-danger">
        Generate PDF
    </a>
</div>

<div class="card">
    <div class="card-header">
        <div>
            <h2>Alarm History</h2>
            <span class="card-description">Filtered alarm events</span>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Alarm Name</th>
                    <th>Raise Time</th>
                    <th>Priority</th>
                    <th>Source Server</th>
                    <th>Synced At</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-state">No alarm records found.</td>
                    </tr>
                }
                else
                {
                    foreach (var alarm in Model.Items)
                    {
                        <tr>
                            <td>@alarm.Id</td>
                            <td><span class="alarm-name">@alarm.AlarmName</span></td>
                            <td class="alarm-time" data-utc="@alarm.RaiseTime.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")"></td>
                            <td>
                                @if (alarm.Priority.HasValue)
                                {
                                    <span class="priority-badge">@alarm.Priority</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td><span class="server-badge">@alarm.SourceServer</span></td>
                            <td class="alarm-time" data-utc="@alarm.SyncedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")"></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination">
            <div class="pagination-info">
                Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>
            </div>
            <div class="pagination-buttons">
                @if (Model.PageNumber > 1)
                {
                    <a asp-controller="Reports" asp-action="Index"
                       asp-route-page="@(Model.PageNumber - 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@filter.Search"
                       asp-route-priority="@filter.Priority"
                       asp-route-sourceServer="@filter.SourceServer"
                       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="pagination-btn">Previous</a>
                }

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.PageNumber)
                    {
                        <span class="pagination-btn active">@i</span>
                    }
                    else if (i == 1 || i == Model.TotalPages || Math.Abs(i - Model.PageNumber) <= 2)
                    {
                        <a asp-controller="Reports" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-search="@filter.Search"
                           asp-route-priority="@filter.Priority"
                           asp-route-sourceServer="@filter.SourceServer"
                           asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                           asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                           class="pagination-btn">@i</a>
                    }
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a asp-controller="Reports" asp-action="Index"
                       asp-route-page="@(Model.PageNumber + 1)"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-search="@filter.Search"
                       asp-route-priority="@filter.Priority"
                       asp-route-sourceServer="@filter.SourceServer"
                       asp-route-startDate="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       asp-route-endDate="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))"
                       class="pagination-btn">Next</a>
                }
            </div>
        </div>
    }
</div>

