@model WinCCDashboard.Domain.Entities.ReportDefinition

@{
    ViewData["Title"] = Model.Title;

    var folder = ViewBag.Folder as string;

    // TEMPORARY — hardcoded URL for testing
    var embedUrl =
        $"http://localhost/ReportServer?{folder}/{Model.RdlName}" +
        "&rs:Command=Render" +
        "&rc:Toolbar=true" +
        "&rc:Parameters=true" +
        "&rc:Zoom=100";
}

<div class="page-header">
    <div>
        <h1>@Model.Title</h1>
        <p class="page-subtitle">@Model.Description</p>
    </div>
    <div style="display:flex; gap:8px;">
        <a asp-action="Export" asp-route-key="@Model.ReportKey" class="btn btn-danger">Download PDF</a>
        <a asp-action="Index" class="btn btn-secondary">All Reports</a>
    </div>
</div>

<div class="card" style="overflow:hidden;">
    <iframe src="@embedUrl" style="width:100%; height:900px; border:0; display:block;" title="@Model.Title"></iframe>
</div>