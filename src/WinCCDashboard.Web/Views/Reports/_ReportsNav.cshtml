@{
    var selected = ViewBag.SelectedReport as string ?? "AlarmHistory";

    string Active(string name) =>
        string.Equals(selected, name, StringComparison.OrdinalIgnoreCase)
            ? "report-card active"
            : "report-card";
}

<div class="card">
    <div class="card-header">
        <div>
            <h2>Report Type</h2>
            <span class="card-description">
                Select the report you want to view or generate
            </span>
        </div>
    </div>

    <div class="reports-grid">

        <a asp-controller="Reports" asp-action="Index"
           class="@Active("AlarmHistory")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                    <line x1="16" y1="13" x2="8" y2="13" />
                    <line x1="16" y1="17" x2="8" y2="17" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Alarm History</h3>
                <p>Complete alarm event history with filters, pagination and PDF export.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="DailySummary"
           class="@Active("DailySummary")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Daily Alarm Summary</h3>
                <p>Daily alarm counts and priority distribution.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="HourlyAnalysis"
           class="@Active("HourlyAnalysis")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Hourly Alarm Analysis</h3>
                <p>Analyze alarm activity by hour of day.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="TopAlarms"
           class="@Active("TopAlarms")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="19" x2="12" y2="5" />
                    <polyline points="5 12 12 5 19 12" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Top Alarms</h3>
                <p>Identify the most frequently occurring alarms.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="PriorityAnalysis"
           class="@Active("PriorityAnalysis")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    <line x1="12" y1="9" x2="12" y2="13" />
                    <line x1="12" y1="17" x2="12.01" y2="17" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Priority Analysis</h3>
                <p>Analyze alarms according to their priority.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="ServerAnalysis"
           class="@Active("ServerAnalysis")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
                    <line x1="6" y1="6" x2="6.01" y2="6" />
                    <line x1="6" y1="18" x2="6.01" y2="18" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Server Analysis</h3>
                <p>Compare alarm activity between servers.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="RedundancyEvents"
           class="@Active("RedundancyEvents")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 4 23 10 17 10" />
                    <polyline points="1 20 1 14 7 14" />
                    <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15" />
                </svg>
            </div>
            <div class="report-content">
                <h3>Redundancy Events</h3>
                <p>Analyze redundancy and failover related events.</p>
            </div>
        </a>

        <a asp-controller="Reports" asp-action="SystemEvents"
           class="@Active("SystemEvents")">
            <div class="report-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3" />
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" />
                </svg>
            </div>
            <div class="report-content">
                <h3>System / Connection Events</h3>
                <p>Analyze system, connection and communication events.</p>
            </div>
        </a>

    </div>
</div>