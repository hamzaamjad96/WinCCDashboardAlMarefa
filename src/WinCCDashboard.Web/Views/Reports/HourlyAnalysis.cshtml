@model List<WinCCCustomDashboardMarefa.Models.HourlyAnalysis>

@{
    ViewData["Title"] = "Hourly Alarm Analysis";

    var filter = ViewBag.Filter as WinCCCustomDashboardMarefa.Models.AlarmReportFilter
                 ?? new WinCCCustomDashboardMarefa.Models.AlarmReportFilter();

    var maxCount = Model.Count > 0 ? Model.Max(x => x.TotalAlarms) : 0;
    long grandTotal = Model.Sum(x => x.TotalAlarms);
}

<div class="page-header">
    <div>
        <h1>Hourly Alarm Analysis</h1>
        <p class="page-subtitle">Alarm activity distributed by hour of day (UTC)</p>
    </div>
</div>

@await Html.PartialAsync("_ReportsNav")

<div class="card">
    <div class="card-header">
        <div>
            <h2>Filters</h2>
            <span class="card-description">Filter hourly analysis</span>
        </div>
    </div>

    <form asp-controller="Reports" asp-action="HourlyAnalysis" method="get" class="report-filters">

        <div class="filter-group">
            <label for="priority">Priority</label>
            <select id="priority" name="priority">
                <option value="">All Priorities</option>
                <option value="0" selected="@(filter.Priority == 0 ? "selected" : null)">0</option>
                <option value="1" selected="@(filter.Priority == 1 ? "selected" : null)">1</option>
                <option value="4" selected="@(filter.Priority == 4 ? "selected" : null)">4</option>
                <option value="12" selected="@(filter.Priority == 12 ? "selected" : null)">12</option>
                <option value="16" selected="@(filter.Priority == 16 ? "selected" : null)">16</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="sourceServer">Source Server</label>
            <select id="sourceServer" name="sourceServer">
                <option value="">All Servers</option>
                <option value="SRV-01" selected="@(filter.SourceServer == "SRV-01" ? "selected" : null)">SRV-01</option>
                <option value="SRV-02" selected="@(filter.SourceServer == "SRV-02" ? "selected" : null)">SRV-02</option>
            </select>
        </div>

        <div class="filter-group">
            <label for="startDate">From</label>
            <input type="datetime-local" id="startDate" name="startDate"
                   value="@(filter.StartDate?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="filter-group">
            <label for="endDate">To</label>
            <input type="datetime-local" id="endDate" name="endDate"
                   value="@(filter.EndDate?.ToString("yyyy-MM-ddTHH:mm"))" />
        </div>

        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-controller="Reports" asp-action="HourlyAnalysis" class="btn btn-secondary">Clear</a>
        </div>
    </form>
</div>

<div class="report-actions-bar">
    <div>
        <span class="results-info">
            <strong>@grandTotal</strong> alarms across <strong>@Model.Count</strong> hours
        </span>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div>
            <h2>Hourly Distribution</h2>
            <span class="card-description">Alarm counts grouped by hour</span>
        </div>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Hour</th>
                    <th>Distribution</th>
                    <th>Total</th>
                    <th>High Priority</th>
                    <th>Priority 1</th>
                    <th>Priority 4</th>
                    <th>Priority 12</th>
                    <th>SRV-01</th>
                    <th>SRV-02</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="empty-state">No data found.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var pct = maxCount == 0 ? 0 : (int)((item.TotalAlarms * 100) / maxCount);
                        <tr>
                            <td><strong>@item.Hour.ToString("D2"):00</strong></td>
                            <td style="min-width:140px;">
                                <div style="background:#e5e7eb;border-radius:4px;height:14px;overflow:hidden;">
                                    <div style="background:#2563eb;height:100%;width:@(pct)%;"></div>
                                </div>
                            </td>
                            <td><strong>@item.TotalAlarms</strong></td>
                            <td><span class="priority-badge">@item.HighPriorityAlarms</span></td>
                            <td>@item.Priority1Alarms</td>
                            <td>@item.Priority4Alarms</td>
                            <td>@item.Priority12Alarms</td>
                            <td><span class="server-badge">@item.Srv01Alarms</span></td>
                            <td><span class="server-badge">@item.Srv02Alarms</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>